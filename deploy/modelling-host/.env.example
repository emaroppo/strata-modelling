# Copy to deploy/gpu/.env on the machine with the GPU, and fill it in.
#
# Absolute paths throughout. systemd does not inherit the working directory
# you would expect, and mounting these at the same paths inside a container
# later makes this file identical in both worlds — which removes a whole
# class of "works natively, empty in the container" confusion.

# Runs, checkpoints and materialised dataset versions. Checkpoints are
# ~350MB each, so put this somewhere with room.
STRATA_MODELLING_ROOT=/home/ubuntu/strata/modelling

# Blobs this host already has. Pointing it at the CLI's own blob directory
# means the service starts warm and its first round links files instead of
# pulling the corpus out of the bucket. Shared with the CLI on purpose:
# both write content-addressed files through a temporary name, so neither
# can serve the other a half-written one.
STRATA_BLOBS_CACHE=/home/ubuntu/git/strata/catalog/blobs

# Where the catalog is: this machine's config.toml, the one its CLI uses. Its
# [catalog] default is the catalog trained from, so pointing this host at
# another one is changing that default and restarting — nothing here changes.
STRATA_CONFIG=/home/ubuntu/git/strata/config.toml

# The index's password. config.toml names the index without one.
PGPASSWORD=

# Shared with whoever submits rounds. The service refuses to start without
# it: a host that trains what anyone asks it to is not a service.
STRATA_MODELLING_TOKEN=

# The bucket's credentials. The READ-ONLY key belongs here — this host reads
# samples and writes nothing to the bucket.
STRATA_S3_ACCESS_KEY=
STRATA_S3_SECRET_KEY=

# Where it listens. 0.0.0.0 so the laptop can reach it.
STRATA_SERVE_HOST=0.0.0.0
STRATA_SERVE_PORT=8082
