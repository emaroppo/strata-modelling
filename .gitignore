__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
dist/
# Sibling checkouts the CI step builds wheels from; see .github/sibling-wheels.sh
.siblings/
# Until the strata packages are on an index a lock here would pin wheels
# built beside the checkout, so none is kept; the strata workspace keeps one.
uv.lock

# A host's own: written by deploy/*/bootstrap-env.sh, never committed.
config*.toml
!config.example.toml
.env
!.env.example
# The unit bootstrap-env.sh renders from strata-modelling.service.in.
deploy/modelling-host/strata-modelling.service
